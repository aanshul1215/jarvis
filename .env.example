# Copy to .env locally, then export the variables in your shell. Never commit .env.
JARVIS_HOME=/absolute/path/outside/this/repository/jarvis-data
JARVIS_MODE=OFF
ALPACA_PAPER_KEY_ID=replace-with-paper-key
ALPACA_PAPER_SECRET_KEY=replace-with-paper-secret
JARVIS_EQUITY_UNIVERSE=AAPL,SPY
JARVIS_CRYPTO_UNIVERSE=BTC/USD,ETH/USD
JARVIS_DATA_INTERVAL_EQUITY=1Hour
JARVIS_DATA_INTERVAL_CRYPTO=1Hour
JARVIS_RESEARCH_SCHEDULE=manual
JARVIS_LOG_LEVEL=INFO
# SEC requires 'Name email' in the User-Agent of every automated request. Keep the real value out of Git.
JARVIS_SEC_USER_AGENT=Your Name your.email@example.com
JARVIS_DASHBOARD_HOST=127.0.0.1
JARVIS_DASHBOARD_PORT=8765
# Risk limits belong in JARVIS_HOME/config/owner-policy.json; see DEVELOPER_SETUP.md.
